<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_today_board_bg"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="9dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="26dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="오늘 할 일"
            android:textColor="#FF111318"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0개 남음"
            android:textColor="#FF4E6D1D"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="오늘 할 일을 모두 끝냈습니다 ✓"
        android:textColor="#FF6D7784"
        android:textSize="12sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_row1"
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:gravity="center_vertical"
        android:text="☐  할 일"
        android:textColor="#FF20242A"
        android:textSize="12sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_row2"
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:gravity="center_vertical"
        android:text="☐  할 일"
        android:textColor="#FF20242A"
        android:textSize="12sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_row3"
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:gravity="center_vertical"
        android:text="☐  할 일"
        android:textColor="#FF20242A"
        android:textSize="12sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_row4"
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:gravity="center_vertical"
        android:text="☐  할 일"
        android:textColor="#FF20242A"
        android:textSize="12sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_open"
        android:layout_width="match_parent"
        android:layout_height="18dp"
        android:gravity="end|center_vertical"
        android:text="PERSONAL CENTER 열기 ›"
        android:textColor="#FF6D7784"
        android:textSize="9sp" />
</LinearLayout>
